rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Verified Firebase Auth ID token is required for all social features.
    function signedIn() { return request.auth != null; }
    function maintenanceOpen() { return !exists(/databases/$(database)/documents/system/maintenance) || get(/databases/$(database)/documents/system/maintenance).data.enabled != true; }
    function authd() { return signedIn() && request.auth.token.email_verified == true && (maintenanceOpen() || request.auth.uid == ownerUid()); }
    function self(uid) { return authd() && request.auth.uid == uid; }
    function ownerUid() { return "ElpAtxZIBCZVsLBcLzgdIsr8T1w2"; }
    function profile(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function existsUser(uid) { return exists(/databases/$(database)/documents/users/$(uid)); }
    function owner() { return self(ownerUid()) && existsUser(ownerUid()) && profile(ownerUid()).data.get('role','user') == 'owner'; }
    function role() { return authd() && existsUser(request.auth.uid) ? profile(request.auth.uid).data.get('role','user') : 'user'; }
    function mod() { return owner() || role() in ['moderator','admin']; }
    function txt(v,min,max) { return v is string && v.size() >= min && v.size() <= max; }
    function changed(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    function fieldChanged(field) { return request.resource.data.diff(resource.data).affectedKeys().hasAny([field]); }
    function optionalUrl(v) { return txt(v,0,2048) && (v == '' || v.matches('^https://[^ ].*')); }
    function profileFields(d) {
      return (!('bio' in d) || txt(d.bio,0,160)) &&
        (!('username' in d) || username(d.username)) &&
        (!('avatarUrl' in d) || optionalUrl(d.avatarUrl)) &&
        (!('bannerUrl' in d) || optionalUrl(d.bannerUrl)) &&
        (!('websiteUrl' in d) || optionalUrl(d.websiteUrl));
    }
    function profileChanges() {
      // Validate only changed optional fields so legacy data remains editable.
      return (!fieldChanged('name') || !('name' in request.resource.data) || txt(request.resource.data.name,3,20)) &&
        (!fieldChanged('bio') || !('bio' in request.resource.data) || txt(request.resource.data.bio,0,160)) &&
        (!fieldChanged('username') || !('username' in request.resource.data) || username(request.resource.data.username)) &&
        (!fieldChanged('avatarUrl') || !('avatarUrl' in request.resource.data) || optionalUrl(request.resource.data.avatarUrl)) &&
        (!fieldChanged('bannerUrl') || !('bannerUrl' in request.resource.data) || optionalUrl(request.resource.data.bannerUrl)) &&
        (!fieldChanged('websiteUrl') || !('websiteUrl' in request.resource.data) || optionalUrl(request.resource.data.websiteUrl)) &&
        (!fieldChanged('updatedAt') || request.resource.data.updatedAt == request.time);
    }
    function username(v) { return v is string && v.matches('^[a-z0-9_]{3,20}$'); }
    function badge(v) { return v is int && v >= 0 && v <= 5; }
    function chatPath(id) { return /databases/$(database)/documents/chats/$(id); }
    function chatMember(id) { return authd() && exists(chatPath(id)) && request.auth.uid in get(chatPath(id)).data.participants; }
    function validMembers(p) {
      return authd() && p is list && p.size() == 2 &&
        p[0] is string && p[1] is string && p[0] != p[1] &&
        request.auth.uid in p && p[0] < p[1] && existsUser(p[0]) && existsUser(p[1]);
    }
    match /users/{uid} {
      // Registration may create/read ONLY its own limited profile before email verification.
      allow get: if authd() || (maintenanceOpen() && signedIn() && request.auth.uid == uid);
      allow list: if authd();
      allow create: if signedIn() && maintenanceOpen() && request.auth.uid == uid && request.resource.data.keys().hasOnly([
        'name','username','bio','avatarUrl','bannerUrl','websiteUrl','status','privacy','createdAt'
      ]) && txt(request.resource.data.name,3,20) && profileFields(request.resource.data) &&
        request.resource.data.createdAt == request.time;
      allow update: if (
        self(uid) && changed(['name','username','bio','avatarUrl','bannerUrl','websiteUrl','status','privacy','pinnedPostId','updatedAt']) &&
        profileChanges()
      ) || (
        owner() && uid != ownerUid() && resource.data.get('role','user') != 'owner' &&
        changed(['role','verification']) &&
        request.resource.data.get('role','user') in ['user','moderator','admin'] &&
        badge(request.resource.data.get('verification',0))
      );
      allow delete: if false;
      match /likes/{postId} {
        allow get,list: if self(uid);
        allow create: if self(uid) && exists(/databases/$(database)/documents/posts/$(postId)) &&
          request.resource.data.keys().hasOnly(['createdAt']) &&
          request.resource.data.createdAt == request.time;
        allow delete: if self(uid);
        allow update: if false;
      }
      match /saved/{postId} {
        allow get,list: if self(uid);
        // Version 3.0 allowed saving the same item again. Keep that behavior,
        // but require a real post and a trusted server timestamp.
        allow create,update: if self(uid) &&
          exists(/databases/$(database)/documents/posts/$(postId)) &&
          request.resource.data.keys().hasOnly(['createdAt']) &&
          request.resource.data.createdAt == request.time;
        allow delete: if self(uid);
      }
      match /followers/{followerId} {
        allow get,list: if authd();
        allow create: if self(followerId) && uid != followerId && existsUser(uid) &&
          request.resource.data.keys().hasOnly(['createdAt']) &&
          request.resource.data.createdAt == request.time;
        allow delete: if self(followerId);
        allow update: if false;
      }
      match /following/{targetId} {
        allow get,list: if authd();
        allow create: if self(uid) && uid != targetId && existsUser(targetId) &&
          request.resource.data.keys().hasOnly(['createdAt']) &&
          request.resource.data.createdAt == request.time;
        allow delete: if self(uid);
        allow update: if false;
      }
      match /notifications/{notificationId} {
        allow get,list: if self(uid);
        allow create: if false; // trusted server only
        allow update: if self(uid) && changed(['read']) && request.resource.data.read == true;
        allow delete: if self(uid);
      }
    }
    match /posts/{postId} {
      allow get,list: if authd();
      allow create: if authd() && request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid','text','imageUrl','imagePosition','createdAt']) &&
        request.resource.data.createdAt == request.time &&
        txt(request.resource.data.text,1,1000) &&
        (!('imagePosition' in request.resource.data) || request.resource.data.imagePosition in ['top','bottom']) &&
        (!('imageUrl' in request.resource.data) ||
          (txt(request.resource.data.imageUrl,1,2048) && request.resource.data.imageUrl.matches('^https://.*')));
      allow update: if authd() && resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        changed(['text','imageUrl','imagePosition','editedAt']) && txt(request.resource.data.text,1,1000) &&
        (!('imagePosition' in request.resource.data) || request.resource.data.imagePosition in ['top','bottom']) &&
        (!fieldChanged('imageUrl') || !('imageUrl' in request.resource.data) ||
          (txt(request.resource.data.imageUrl,1,2048) && request.resource.data.imageUrl.matches('^https://.*'))) &&
        (!fieldChanged('editedAt') || request.resource.data.editedAt == request.time);
      allow delete: if owner() || (authd() && resource.data.uid == request.auth.uid);
      match /comments/{commentId} {
        allow get,list: if authd();
        allow create: if authd() && request.resource.data.uid == request.auth.uid &&
          exists(/databases/$(database)/documents/posts/$(postId)) &&
          request.resource.data.keys().hasOnly(['uid','text','createdAt']) &&
          request.resource.data.createdAt == request.time &&
          txt(request.resource.data.text,1,300);
        allow update: if authd() && resource.data.uid == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          changed(['text','editedAt']) && txt(request.resource.data.text,1,300) &&
          (!fieldChanged('editedAt') || request.resource.data.editedAt == request.time);
        allow delete: if owner() || (authd() && resource.data.uid == request.auth.uid);
      }
    }
    // Canonical per-post like records support accurate global counts.
    match /posts/{postId}/likes/{uid} {
      allow get,list: if authd();
      allow create: if self(uid) && exists(/databases/$(database)/documents/posts/$(postId)) &&
        request.resource.data.keys().hasOnly(['createdAt']) &&
        request.resource.data.createdAt == request.time;
      allow delete: if self(uid);
      allow update: if false;
    }
    match /chats/{chatId} {
      // Allow an authenticated participant to probe a missing canonical chat.
      // An existing chat remains readable only by its actual members.
      // Missing-chat probes are allowed only when the caller UID appears in the ID.
      // Existing chats are readable exclusively by their recorded participants.
      allow get: if authd() && (
        (resource != null && request.auth.uid in resource.data.participants) ||
        (resource == null && (
          chatId.matches('^' + request.auth.uid + '_.*$') ||
          chatId.matches('^.*_' + request.auth.uid + '$')
        ))
      );
      allow list: if authd() && request.auth.uid in resource.data.participants;
      allow create: if validMembers(request.resource.data.participants) &&
        chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1] &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.keys().hasOnly(['participants','updatedAt','lastText']) &&
        txt(request.resource.data.get('lastText',''),0,100);
      allow update: if authd() && request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants &&
        changed(['updatedAt','lastText','pinnedMessageId','pinnedText']) &&
        txt(request.resource.data.get('lastText',''),0,2000) &&
        txt(request.resource.data.get('pinnedText',''),0,160) &&
        (!fieldChanged('updatedAt') || request.resource.data.updatedAt == request.time);
      allow delete: if false;
      match /messages/{messageId} {
        allow get,list: if chatMember(chatId);
        allow create: if chatMember(chatId) && request.resource.data.senderId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['senderId','type','text','sticker','createdAt','replyTo','replyText']) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.type in ['text','sticker'] &&
          txt(request.resource.data.text,request.resource.data.type == 'text' ? 1 : 0,2000) &&
          txt(request.resource.data.get('sticker',''),request.resource.data.type == 'sticker' ? 1 : 0,500) &&
          txt(request.resource.data.get('replyText',''),0,160) &&
          (!('replyTo' in request.resource.data) || txt(request.resource.data.replyTo,1,200));
        allow update: if chatMember(chatId) &&
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.createdAt == resource.data.createdAt &&
          (
            (self(resource.data.senderId) && changed(['text','editedAt']) &&
              txt(request.resource.data.text,request.resource.data.type == 'text' ? 1 : 0,2000) &&
              (!fieldChanged('editedAt') || request.resource.data.editedAt == request.time))
            ||
            (!self(resource.data.senderId) && changed(['readAt']) &&
              resource.data.get('readAt',null) == null && request.resource.data.readAt == request.time)
          );
        // Reaction arrays are intentionally not writable by clients: untrusted clients
        // could forge another user's reactions. Migrate to per-user documents or backend.
        allow delete: if chatMember(chatId) && self(resource.data.senderId);
      }
      match /reactions/{reactionId} {
        allow get,list: if chatMember(chatId);
        allow create: if chatMember(chatId) &&
          request.resource.data.keys().hasOnly(['uid','messageId','emoji','createdAt']) &&
          request.resource.data.uid == request.auth.uid &&
          reactionId == request.resource.data.messageId + '_' + request.auth.uid &&
          txt(request.resource.data.messageId,1,200) &&
          request.resource.data.emoji in ['❤️','👍','😂','😮','😢','🔥'] &&
          exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.messageId)) &&
          request.resource.data.createdAt == request.time;
        allow update: if chatMember(chatId) &&
          resource.data.uid == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.messageId == resource.data.messageId &&
          changed(['emoji','createdAt']) &&
          request.resource.data.emoji in ['❤️','👍','😂','😮','😢','🔥'] &&
          request.resource.data.createdAt == request.time &&
          exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(resource.data.messageId));
        allow delete: if chatMember(chatId) && resource.data.uid == request.auth.uid;
      }
      match /typing/{uid} {
        allow get,list: if chatMember(chatId);
        allow create,update: if chatMember(chatId) && self(uid) &&
          request.resource.data.keys().hasOnly(['uid','typing','updatedAt']) &&
          request.resource.data.uid == uid && request.resource.data.typing is bool &&
          request.resource.data.updatedAt == request.time;
        allow delete: if chatMember(chatId) && self(uid);
      }
    }
    match /presence/{uid} {
      allow get,list: if authd();
      allow create,update: if self(uid) &&
        request.resource.data.keys().hasOnly(['uid','lastSeen']) &&
        request.resource.data.uid == uid &&
        request.resource.data.lastSeen == request.time;
      allow delete: if false;
    }
    match /verificationRequests/{uid} {
      allow get: if self(uid) || owner();
      allow list: if owner();
      allow create: if self(uid) && request.resource.data.keys().hasOnly([
        'uid','type','reason','status','createdAt'
      ]) && request.resource.data.uid == uid && request.resource.data.status == 'pending' &&
        request.resource.data.type is int && request.resource.data.type >= 1 &&
        request.resource.data.type <= 5 && txt(request.resource.data.reason,10,500) &&
        request.resource.data.createdAt == request.time;
      allow update: if owner() && resource.data.status == 'pending' &&
        changed(['status','reviewedBy','reviewedAt']) &&
        request.resource.data.status in ['approved','rejected'] &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
    match /reports/{reportId} {
      allow get: if mod() || (authd() && resource.data.reporterId == request.auth.uid);
      allow list: if mod();
      allow create: if authd() && request.resource.data.keys().hasOnly([
        'reporterId','kind','targetId','reason','status','createdAt'
      ]) && request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.kind in ['post','user','comment','message'] &&
        txt(request.resource.data.targetId,1,200) && txt(request.resource.data.reason,10,500) &&
        request.resource.data.createdAt == request.time;
      allow update: if owner() && resource.data.status == 'pending' &&
        changed(['status','resolution','reviewedBy','reviewedAt']) &&
        request.resource.data.status in ['resolved','dismissed'] &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
    match /auditLogs/{logId} {
      allow get,list: if owner();
      allow create: if owner() &&
        request.resource.data.keys().hasOnly(['actorId','action','targetId','details','createdAt']) &&
        request.resource.data.actorId == request.auth.uid &&
        txt(request.resource.data.action,1,100) &&
        txt(request.resource.data.targetId,1,200) &&
        request.resource.data.createdAt == request.time;
      allow update,delete: if false;
    }
    match /system/maintenance {
      allow get: if true;
      allow list: if false;
      allow create,update: if owner() && request.resource.data.keys().hasOnly(['enabled','reason','until','updatedAt']) && request.resource.data.enabled is bool && txt(request.resource.data.reason,0,240) && txt(request.resource.data.until,0,100) && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // NEXORA groups: creation/approval is trusted-server only.
    // One request document per user and type; clients cannot reset approvals.
    // Group requests have deterministic IDs: UID_kind. Owner alone reviews.
    // Owner approval is bound to Firebase Auth UID, not a mutable profile role.
    function groupOwner() { return self(ownerUid()); }
    function groupDoc(id) { return get(/databases/$(database)/documents/groups/$(id)); }
    function memberPath(id,uid) { return /databases/$(database)/documents/groups/$(id)/members/$(uid); }
    function isGroupMember(id) { return authd() && exists(memberPath(id,request.auth.uid)); }
    function isGroupLeader(id) { return isGroupMember(id) && get(memberPath(id,request.auth.uid)).data.role == 'leader'; }
    function validGroupTag(kind,tag) {
      return kind == 'clan' ? (tag is string && tag.matches('^[A-Za-z0-9_]{3}$')) : tag == '';
    }
    function validAppeal(data) {
      return data.keys().hasOnly(['ownerId','kind','name','tag','description','category','reason','status','createdAt']) &&
        data.kind in ['clan','community'] &&
        txt(data.name,3,40) &&
        validGroupTag(data.kind,data.tag) &&
        txt(data.description,0,500) &&
        txt(data.category,2,40) &&
        txt(data.reason,10,500) &&
        data.status == 'pending' &&
        data.createdAt == request.time;
    }
    match /groupRequests/{requestId} {
      allow get: if groupOwner() || (authd() && resource.data.ownerId == request.auth.uid);
      allow list: if groupOwner();
      allow create: if authd() &&
        requestId == request.auth.uid + '_' + request.resource.data.kind &&
        request.resource.data.ownerId == request.auth.uid &&
        validAppeal(request.resource.data);
      allow update: if (
        authd() && resource.data.ownerId == request.auth.uid &&
        resource.data.status == 'rejected' &&
        !exists(/databases/$(database)/documents/groups/$(requestId)) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.kind == resource.data.kind &&
        validAppeal(request.resource.data)
      ) || (
        groupOwner() && resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy','reviewNote']) &&
        request.resource.data.status in ['approved','rejected'] &&
        request.resource.data.reviewedBy == request.auth.uid &&
        txt(request.resource.data.reviewNote,0,500) &&
        request.resource.data.reviewedAt == request.time &&
        (request.resource.data.status == 'rejected' ||
          getAfter(/databases/$(database)/documents/groups/$(requestId)).data.ownerId == resource.data.ownerId)
      );
      allow delete: if false;
    }
    match /groups/{groupId} {
      allow get,list: if authd() && resource.data.status == 'active';
      allow create: if groupOwner() &&
        request.resource.data.keys().hasOnly(['ownerId','kind','name','tag','description','category','status','createdAt','verified','memberCount']) &&
        groupId == request.resource.data.ownerId + '_' + request.resource.data.kind &&
        request.resource.data.kind in ['clan','community'] &&
        request.resource.data.status == 'active' &&
        request.resource.data.verified == false &&
        request.resource.data.memberCount == 1 &&
        validGroupTag(request.resource.data.kind,request.resource.data.tag) &&
        get(/databases/$(database)/documents/groupRequests/$(groupId)).data.status == 'pending' &&
        getAfter(/databases/$(database)/documents/groupRequests/$(groupId)).data.status == 'approved' &&
        request.resource.data.ownerId == get(/databases/$(database)/documents/groupRequests/$(groupId)).data.ownerId &&
        request.resource.data.kind == get(/databases/$(database)/documents/groupRequests/$(groupId)).data.kind &&
        request.resource.data.name == get(/databases/$(database)/documents/groupRequests/$(groupId)).data.name &&
        request.resource.data.tag == get(/databases/$(database)/documents/groupRequests/$(groupId)).data.tag &&
        request.resource.data.description == get(/databases/$(database)/documents/groupRequests/$(groupId)).data.description &&
        request.resource.data.category == get(/databases/$(database)/documents/groupRequests/$(groupId)).data.category &&
        request.resource.data.createdAt == request.time &&
        getAfter(memberPath(groupId,request.resource.data.ownerId)).data.role == 'leader' &&
        (request.resource.data.kind == 'community' ||
          getAfter(/databases/$(database)/documents/groupTags/$(request.resource.data.tag)).data.groupId == groupId);
      allow update: if (
        groupOwner() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified','verifiedAt']) &&
        request.resource.data.verified is bool &&
        request.resource.data.verifiedAt == request.time
      ) || (
        authd() && resource.data.status == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) &&
        request.resource.data.memberCount is int &&
        request.resource.data.memberCount >= 1 &&
        (resource.data.kind == 'clan' || request.resource.data.memberCount <= 30) &&
        (
          (request.resource.data.memberCount == resource.data.memberCount + 1 &&
            !exists(memberPath(groupId,request.auth.uid)) &&
            getAfter(memberPath(groupId,request.auth.uid)).data.uid == request.auth.uid &&
            getAfter(memberPath(groupId,request.auth.uid)).data.role == 'member') ||
          (request.resource.data.memberCount == resource.data.memberCount - 1 &&
            exists(memberPath(groupId,request.auth.uid)) &&
            get(memberPath(groupId,request.auth.uid)).data.role == 'member' &&
            !existsAfter(memberPath(groupId,request.auth.uid)))
        )
      );
      allow delete: if false;
      match /members/{uid} {
        allow get: if groupOwner() || (authd() && request.auth.uid == uid) || isGroupMember(groupId);
        allow list: if isGroupMember(groupId);
        allow create: if (
          groupOwner() && request.resource.data.keys().hasOnly(['uid','role','joinedAt']) &&
          request.resource.data.uid == uid &&
          request.resource.data.role == 'leader' &&
          request.resource.data.joinedAt == request.time &&
          getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == uid
        ) || (
          self(uid) &&
          request.resource.data.keys().hasOnly(['uid','role','joinedAt']) &&
          request.resource.data.uid == uid &&
          request.resource.data.role == 'member' &&
          request.resource.data.joinedAt == request.time &&
          groupDoc(groupId).data.status == 'active' &&
          getAfter(/databases/$(database)/documents/groups/$(groupId)).data.memberCount == groupDoc(groupId).data.memberCount + 1 &&
          (groupDoc(groupId).data.kind == 'clan' || groupDoc(groupId).data.memberCount < 30)
        );
        allow update: if false;
        allow delete: if self(uid) && resource.data.role == 'member' &&
          getAfter(/databases/$(database)/documents/groups/$(groupId)).data.memberCount == groupDoc(groupId).data.memberCount - 1;
      }
      match /messages/{messageId} {
        allow get,list: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) &&
          (groupDoc(groupId).data.kind == 'community' || isGroupLeader(groupId)) &&
          request.resource.data.keys().hasOnly(['senderId','type','text','createdAt']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.type == 'text' &&
          txt(request.resource.data.text,1,2000) &&
          request.resource.data.createdAt == request.time;
        allow update,delete: if false;
      }
    }
    match /groupTags/{tag} {
      allow get: if authd();
      allow list: if false;
      allow create: if groupOwner() &&
        tag.matches('^[A-Za-z0-9_]{3}$') &&
        request.resource.data.keys().hasOnly(['groupId','createdAt']) &&
        request.resource.data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.tag == tag &&
        getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.kind == 'clan';
      allow update,delete: if false;
    }
    // Live randomizer: only the fixed Firebase Auth owner may publish draws.
    match /randomizerLive/{drawId} {
      allow get: if authd() && drawId == 'current';
      allow list: if false;
      allow create,update: if authd() && request.auth.uid == ownerUid() &&
        drawId == 'current' &&
        request.resource.data.keys().hasOnly(['status','mode','participants','winners','startedAt','updatedAt','durationMs','reels']) &&
        request.resource.data.status in ['running','finished'] &&
        request.resource.data.mode in ['all','selected'] &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() >= 1 &&
        request.resource.data.participants.size() <= 2000 &&
        request.resource.data.reels is list &&
        request.resource.data.reels.size() == request.resource.data.winners.size() &&
        request.resource.data.winners is list &&
        request.resource.data.winners.size() >= 1 &&
        request.resource.data.winners.size() <= 10 &&
        request.resource.data.winners.size() <= request.resource.data.participants.size() &&
        request.resource.data.durationMs is int &&
        request.resource.data.durationMs >= 1000 &&
        request.resource.data.durationMs <= 60000 &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.startedAt == request.time;
      allow delete: if false;
    }
    match /randomizerLuck/{id} {
      allow get: if authd() && id == 'current';
      allow list: if false;
      allow create,update: if authd() && request.auth.uid == ownerUid() && id == 'current' &&
        request.resource.data.keys().hasOnly(['chance','success','angle','startedAt','updatedAt']) &&
        request.resource.data.chance is int && request.resource.data.chance >= 1 && request.resource.data.chance <= 99 &&
        request.resource.data.success is bool &&
        request.resource.data.angle is int && request.resource.data.angle >= 0 && request.resource.data.angle < 360 &&
        request.resource.data.startedAt == request.time && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /{document=**} { allow read,write: if false; }
  }
}
