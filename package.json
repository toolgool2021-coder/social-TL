{
  "name": "nexora-firestore-security-tests",
  "private": true,
  "scripts": {
    "check": "node scripts/check-source.mjs",
    "test": "npm run check && npm run test:unit && npm run test:rules",
    "test:unit": "node --test tests/app*.test.mjs tests/chat*.test.mjs tests/functions*.test.mjs tests/backup*.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-nexora-rules-test --only firestore 'node --test tests/firestore.rules.test.mjs'",
    "backup:rules": "node scripts/backup-firestore-rules.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.0.0"
  }
}
